#!/bin/sh
# easyunblock-cli — простой интерактивный и командный интерфейс (ash) для управления easyunblock.
# Можно вызывать с аргументами (например, easyunblock-cli status) или без аргументов для вызова меню.

. /usr/local/lib/easyunblock/common.sh 2>/dev/null || . /lib/functions.sh 2>/dev/null || true

show_header() {
    printf '\033[1;36m====================================================\033[0m\n'
    printf '\033[1;32m       🚀 EASYUNBLOCK CLI — Управление обходом      \033[0m\n'
    printf '\033[1;36m====================================================\033[0m\n'
}

get_current_mode() {
    uci -q get splify.global.mode 2>/dev/null || echo "blocklist"
}

get_sni_status() {
    _sni="$(uci -q get splify.global.sni_routing 2>/dev/null)"
    [ "$_sni" = "1" ] && printf '\033[1;32mВКЛ (NFQUEUE/nfqws)\033[0m' || printf '\033[1;31mВЫКЛ\033[0m'
}

get_service_status() {
    if /etc/init.d/easyunblock status >/dev/null 2>&1 || ip -4 rule show | grep -q "0x40000"; then
        printf '\033[1;32mРАБОТАЕТ\033[0m'
    else
        printf '\033[1;31mОСТАНОВЛЕН\033[0m'
    fi
}

do_status() {
    show_header
    printf ' Статус службы:        %s\n' "$(get_service_status)"
    printf ' Режим маршрутизации:  \033[1;33m%s\033[0m\n' "$(get_current_mode)"
    printf ' SNI-маршрутизация:    %s\n' "$(get_sni_status)"
    
    _killswitch="$(uci -q get splify.global.killswitch 2>/dev/null || echo 0)"
    [ "$_killswitch" = "1" ] && _ks_str="ВКЛ (Блокировка при сбое)" || _ks_str="ВЫКЛ (Фолбэк на провайдера)"
    printf ' Killswitch:           %s\n' "$_ks_str"
    echo "----------------------------------------------------"
    
    # Списки
    if [ -x /usr/local/sbin/easyunblock-status ]; then
        /usr/local/sbin/easyunblock-status | grep -E "^(ipsum|ru|noz|  [a-zA-Z0-9_]+  handshake)" || true
    fi
    echo "----------------------------------------------------"
}

set_mode() {
    _mode="$1"
    case "$_mode" in
        blocklist|full|split)
            uci -q set splify.global.mode="$_mode"
            uci -q commit splify
            printf '--> Режим изменен на: \033[1;33m%s\033[0m. Применяю правила...\n' "$_mode"
            /usr/local/sbin/easyunblock-apply >/dev/null 2>&1
            printf '--> Готово!\n'
            ;;
        *)
            echo "Ошибка: допустимые режимы: blocklist, full, split"
            ;;
    esac
}

set_sni() {
    _val="$1"
    case "$_val" in
        on|1|enable)
            uci -q set splify.global.sni_routing='1'
            uci -q commit splify
            printf '--> SNI-маршрутизация \033[1;32mВКЛЮЧЕНА\033[0m. Применяю правила...\n'
            /usr/local/sbin/easyunblock-apply >/dev/null 2>&1
            ;;
        off|0|disable)
            uci -q set splify.global.sni_routing='0'
            uci -q commit splify
            printf '--> SNI-маршрутизация \033[1;31mВЫКЛЮЧЕНА\033[0m. Применяю правила...\n'
            /usr/local/sbin/easyunblock-apply >/dev/null 2>&1
            ;;
        *)
            echo "Использование: easyunblock-cli sni <on|off>"
            ;;
    esac
}

add_domain() {
    _type="$1"
    _dom="$2"
    if [ -z "$_dom" ]; then
        echo "Использование: easyunblock-cli domain-add <vpn|direct> <domain.com>"
        return 1
    fi
    case "$_type" in
        vpn)
            uci -q add_list splify.global.vpn_domain="$_dom"
            uci -q commit splify
            printf '--> Домен \033[1;36m%s\033[0m добавлен в VPN список.\n' "$_dom"
            /usr/local/sbin/easyunblock-apply >/dev/null 2>&1
            ;;
        direct)
            uci -q add_list splify.global.direct_domain="$_dom"
            uci -q commit splify
            printf '--> Домен \033[1;36m%s\033[0m добавлен в список ИСКЛЮЧЕНИЙ (прямой канал).\n' "$_dom"
            /usr/local/sbin/easyunblock-apply >/dev/null 2>&1
            ;;
        *)
            echo "Ошибка: тип должен быть 'vpn' или 'direct'"
            ;;
    esac
}

update_lists() {
    printf '--> Обновление списка заблокированных IP (ipsum)...\n'
    [ -x /usr/local/sbin/easyunblock-update-ipsum ] && /usr/local/sbin/easyunblock-update-ipsum || echo "Пропущено"
    printf '--> Обновление списка подсетей РФ/Китая (ru/cn)...\n'
    [ -x /usr/local/sbin/easyunblock-update-ru ] && /usr/local/sbin/easyunblock-update-ru || echo "Пропущено"
    printf '--> Обновление доменных списков...\n'
    [ -x /usr/local/sbin/easyunblock-update-domains ] && /usr/local/sbin/easyunblock-update-domains || echo "Пропущено"
    printf '--> Применение новых списков...\n'
    /usr/local/sbin/easyunblock-apply >/dev/null 2>&1
    printf '\033[1;32m--> Все списки успешно обновлены и применены!\033[0m\n'
}

show_menu() {
    while true; do
        do_status
        echo " 1) Обновить статус"
        echo " 2) Включить обход (Start / Enable)"
        echo " 3) Выключить обход (Stop / Disable)"
        echo " 4) Перезапустить службу и маршрутизацию (Restart)"
        echo " 5) Изменить режим маршрутизации (blocklist / full / split)"
        echo " 6) Включить / Выключить SNI-маршрутизацию («Ход конём»)"
        echo " 7) Добавить домен вручную (в VPN или Исключения)"
        echo " 8) Принудительно обновить списки (IPSUM / RU / Домены)"
        echo " 9) Диагностика системы (doctor)"
        echo " 0) Выход"
        echo "----------------------------------------------------"
        printf 'Выберите действие [0-9]: '
        read -r choice
        case "$choice" in
            1) continue ;;
            2) 
                /etc/init.d/easyunblock enable >/dev/null 2>&1
                /etc/init.d/easyunblock start
                printf '\033[1;32m--> Служба запущена!\033[0m\n'
                sleep 1 ;;
            3) 
                /etc/init.d/easyunblock stop
                [ -x /usr/local/sbin/easyunblock-disable ] && /usr/local/sbin/easyunblock-disable >/dev/null 2>&1
                printf '\033[1;31m--> Служба остановлена, трафик идёт напрямую.\033[0m\n'
                sleep 1 ;;
            4) 
                /etc/init.d/easyunblock restart
                printf '\033[1;32m--> Перезапущено!\033[0m\n'
                sleep 1 ;;
            5) 
                printf 'Введите режим [blocklist | full | split]: '
                read -r m
                [ -n "$m" ] && set_mode "$m"
                sleep 1 ;;
            6) 
                _curr="$(uci -q get splify.global.sni_routing 2>/dev/null)"
                if [ "$_curr" = "1" ]; then
                    set_sni off
                else
                    set_sni on
                fi
                sleep 1 ;;
            7) 
                printf 'Куда направить домен? [vpn | direct]: '
                read -r dt
                printf 'Введите домен (например, example.com): '
                read -r dom
                [ -n "$dt" ] && [ -n "$dom" ] && add_domain "$dt" "$dom"
                sleep 1 ;;
            8) update_lists; printf 'Нажмите Enter для продолжения...'; read -r _ ;;
            9) [ -x /usr/local/sbin/easyunblock-doctor ] && /usr/local/sbin/easyunblock-doctor; printf 'Нажмите Enter для продолжения...'; read -r _ ;;
            0|q|exit) printf 'Выход.\n'; break ;;
            *) printf 'Неверный выбор, попробуйте снова.\n'; sleep 1 ;;
        esac
    done
}

# ---- Диспетчер команд CLI ----
case "$1" in
    status)         do_status ;;
    on|start)       /etc/init.d/easyunblock enable >/dev/null 2>&1; /etc/init.d/easyunblock start; /usr/local/sbin/easyunblock-apply ;;
    off|stop)       /etc/init.d/easyunblock stop; [ -x /usr/local/sbin/easyunblock-disable ] && /usr/local/sbin/easyunblock-disable ;;
    restart|reload) /etc/init.d/easyunblock restart ;;
    mode)           set_mode "$2" ;;
    sni)            set_sni "$2" ;;
    domain-add)     add_domain "$2" "$3" ;;
    update)         update_lists ;;
    doctor|test)    /usr/local/sbin/easyunblock-doctor ;;
    '')             show_menu ;;
    *)
        echo "Использование: easyunblock-cli [команда]"
        echo "Команды:"
        echo "  status                      - показать текущий статус"
        echo "  on | off | restart          - управление службой"
        echo "  mode <blocklist|full|split> - переключение режима маршрутизации"
        echo "  sni <on|off>                - управление SNI-маршрутизацией (nfqws)"
        echo "  domain-add <vpn|direct> <d> - добавить домен в маршрутизацию"
        echo "  update                      - скачать и обновить списки IP/доменов"
        echo "  doctor                      - запуск диагностики системы"
        echo "Без аргументов запускает интерактивное меню."
        exit 1
        ;;
esac
