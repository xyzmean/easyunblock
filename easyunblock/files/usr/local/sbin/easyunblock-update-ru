#!/bin/sh
# easyunblock-update-ru — daily refresh of ru_subnets.lst.
#
# Primary consumer: easyunblock-sync-nozapret (zapret bypass set).
# Also loaded into nft set splify_ru_subnets_v4 if RU routing mode is enabled.
#
# No `set -u`: OpenWrt's config_* helpers aren't nounset-safe.
set -e
. /usr/local/lib/easyunblock/common.sh

[ "$RU_ENABLED" = "1" ] || { log "ru_subnets disabled (RU_ENABLED=0)"; exit 0; }
[ -n "$RU_URL" ] || die "no ru_url configured"
single_run update-ru   # bail if a concurrent run (cron vs self-heal) holds the lock

TMP="/tmp/easyunblock-update-ru.$$"
mkdir -p "$TMP" "$(dirname "$RU_FILE")"
trap 'rm -rf "$TMP"' EXIT INT TERM

curl -fsSL --connect-timeout 10 --max-time 120 --retry 2 \
    -o "$TMP/raw.lst" "$RU_URL" || die "curl failed: $RU_URL"

clean_ip_list < "$TMP/raw.lst" > "$TMP/clean.lst"

count=$(wc -l < "$TMP/clean.lst")
[ "$count" -ge "$RU_MIN_COUNT" ] || die "only $count valid prefixes (need $RU_MIN_COUNT)"

# Persist plain list (consumed by sync-nozapret).
cat "$TMP/clean.lst" > "$RU_FILE"
log "ru_subnets refresh OK: $count prefixes from $RU_URL"

# Optional nft set refresh — only if RU_SET is actually defined live (full mode).
# RU_NFT_FILE is the replay source for failover; like ipsum it's regenerated from
# the daily, min-count-gated download, so no separate backups are kept.
if nft list set "$RU_TABLE" "$RU_SET" >/dev/null 2>&1; then
    mkdir -p "$(dirname "$RU_NFT_FILE")"
    emit_nft_set_block "$RU_TABLE" "$RU_SET" < "$TMP/clean.lst" > "$TMP/live.nft"
    nft -f "$TMP/live.nft" || {
        cp "$TMP/live.nft" /tmp/easyunblock-ru-failed.nft 2>/dev/null || true
        die "atomic ru nft update failed (kept: /tmp/easyunblock-ru-failed.nft)"
    }
    cat "$TMP/live.nft" > "$RU_NFT_FILE"
    log "ru nft set refreshed: $count entries"
fi

# Cascade to zapret bypass.
[ -x /usr/local/sbin/easyunblock-sync-nozapret ] \
    && /usr/local/sbin/easyunblock-sync-nozapret >/dev/null 2>&1 || true
