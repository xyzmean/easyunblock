#!/bin/sh
# easyunblock-uninstall — tear down runtime state + generated files.
#
# Removes ip rules, routes, dnsmasq drop-ins, nft ruleset, cron entries, and
# state files. Does NOT remove UCI configs (/etc/config/splify, network) or the
# scripts themselves — use `apk del easyunblock` to remove the package files.
#
# No `set -u`: OpenWrt's config_* helpers aren't nounset-safe.
LOG_TAG="easyunblock"
log() { logger -t "$LOG_TAG" "$*"; }

WG_TABLE="200"; WG_RULE_PRIO="999"; ANTI_LOOP_PRIO="1000"
DOH_IPS="8.8.8.8 8.8.4.4 1.1.1.1 1.0.0.1 9.9.9.9 149.112.112.112"
STATE_FILE="/var/run/easyunblock-state"
FAIL_COUNTER_FILE="/var/run/easyunblock-failcount"

log "UNINSTALL: removing easyunblock runtime"

# 0. service
if [ -x /etc/init.d/easyunblock ]; then
    /etc/init.d/easyunblock stop    >/dev/null 2>&1 || true
    /etc/init.d/easyunblock disable >/dev/null 2>&1 || true
fi

# 1. runtime routing state
while ip -4 rule del priority "$WG_RULE_PRIO"   >/dev/null 2>&1; do :; done
while ip -4 rule del priority "$ANTI_LOOP_PRIO" >/dev/null 2>&1; do :; done
ip -4 route flush table "$WG_TABLE" >/dev/null 2>&1 || true
for _if in $(uci show splify 2>/dev/null | sed -n "s/.*\.iface='\([^']*\)'/\1/p"); do
    for _ip in $DOH_IPS; do ip -4 route del "$_ip" dev "$_if" >/dev/null 2>&1 || true; done
done

# 2. cron (list refresh entries)
if [ -f /etc/crontabs/root ]; then
    grep -vE '(splify|easyunblock)-' /etc/crontabs/root > /tmp/easyunblock-cron.new || true
    cat /tmp/easyunblock-cron.new > /etc/crontabs/root
    rm -f /tmp/easyunblock-cron.new
    /etc/init.d/cron restart >/dev/null 2>&1 || true
fi

# 3. generated files + runtime state
rm -f /etc/nftables.d/30-splify.nft
rm -f /tmp/dnsmasq.d/splify-*.conf /tmp/dnsmasq.cfg*.d/splify-*.conf /tmp/dnsmasq.d/easyunblock-*.conf /tmp/dnsmasq.cfg*.d/easyunblock-*.conf
/etc/init.d/firewall reload >/dev/null 2>&1 || true
/etc/init.d/dnsmasq restart >/dev/null 2>&1 || true

rm -f "$STATE_FILE" "$FAIL_COUNTER_FILE" /var/run/splify-*.stamp /var/run/splify-*.lock /var/run/easyunblock-*.stamp /var/run/easyunblock-*.lock /var/run/easyunblock-*.sig /var/run/splify-*.sig

log "UNINSTALL: complete"
echo "easyunblock runtime removed. To remove package files: apk del easyunblock"
