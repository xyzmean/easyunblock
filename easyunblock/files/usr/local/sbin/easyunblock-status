#!/bin/sh
# easyunblock-status — print runtime snapshot for debugging.

# No `set -u`: OpenWrt's config_* helpers (sourced below) aren't nounset-safe.
. /usr/local/lib/easyunblock/common.sh

echo "=== easyunblock status ==="
echo "state file: $(cat "$STATE_FILE" 2>/dev/null || echo 'missing')"
echo "killswitch: $KILLSWITCH  (0=leak to WAN on fail, 1=blackhole)"
echo "sni routing: $SNI_ROUTING (NFQUEUE $SNI_NFQUEUE_NUM / nfqws)"
echo ""

echo "--- ip rules (priorities $ANTI_LOOP_PRIO, $WG_RULE_PRIO) ---"
# show rule + its table name if mapped in /etc/iproute2/rt_tables
ip -4 rule show | grep -E "($WG_RULE_PRIO|$ANTI_LOOP_PRIO):" || echo "(no easyunblock rules)"
echo

echo "=== route table $WG_TABLE ==="
ip -4 route show table "$WG_TABLE" 2>/dev/null || echo "(table empty)"
echo

echo "=== nft sets ==="
printf 'ipsum (%s %s): %s entries\n' "$IPSUM_TABLE" "$IPSUM_SET" \
    "$(set_count "$IPSUM_TABLE" "$IPSUM_SET")"
printf 'ru    (%s %s): %s entries\n' "$RU_TABLE" "$RU_SET" \
    "$(set_count "$RU_TABLE" "$RU_SET")"
printf 'noz   (%s %s): %s entries\n' "$ZAPRET_NOZAPRET_TABLE" "$ZAPRET_NOZAPRET_SET" \
    "$(set_count "$ZAPRET_NOZAPRET_TABLE" "$ZAPRET_NOZAPRET_SET")"
echo

echo "=== nft mangle chains ==="
nft list chain inet fw4 splify_endpoint_mark_prerouting 2>/dev/null \
    | sed 's/^/  /' || echo "(endpoint chain missing)"
nft list chain inet fw4 splify_ipsum_mark_prerouting 2>/dev/null \
    | sed 's/^/  /' || echo "(ipsum chain missing)"
nft list chain inet fw4 splify_sni_mark_prerouting 2>/dev/null \
    | sed 's/^/  /' || echo "(sni chain missing or disabled)"
echo

echo "=== endpoint firewall zones ==="
for _if in $(endpoints_by_priority); do
    if _z="$(fw_zone_of_net "$_if")"; then
        printf '  %-8s zone=%-8s masq=%s\n' "$_if" "$_z" \
            "$(fw_zone_has_masq "$_z" && echo yes || echo NO)"
    else
        printf '  %-8s zone=NONE  (fw4 will REJECT LAN->tunnel forwarding)\n' "$_if"
    fi
done
echo

echo "=== per-iface health (ping -I via targets: $HEALTH_TARGETS) ==="
for _if in $(endpoints_by_priority); do
    _hs="$(wg_handshake_age "$_if")"
    _ok=FAIL
    for _t in $HEALTH_TARGETS; do
        ping -c 1 -W "$HEALTH_PING_TIMEOUT" -I "$_if" -q "$_t" >/dev/null 2>&1 && { _ok=OK; break; }
    done
    printf '  %-8s handshake=%ss ping=%s\n' "$_if" "$_hs" "$_ok"
done
