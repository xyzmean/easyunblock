#!/bin/sh /etc/rc.common
START=94
STOP=11
USE_PROCD=1

start_service() {
    . /usr/local/lib/easyunblock/common.sh
    [ "$SNI_ROUTING" = "1" ] || return 0

    local bin=""
    for b in /usr/local/sbin/nfqwsc /usr/bin/nfqwsc /opt/zapret/nfq/nfqwsc; do
        [ -x "$b" ] && bin="$b" && break
    done
    [ -n "$bin" ] || return 0

    local hostlist="/var/run/easyunblock-sni-domains.txt"
    [ -r "$hostlist" ] || touch "$hostlist"

    procd_open_instance
    procd_set_param command "$bin" --qnum=200 --mark-match=0x1 --mark-nomatch=0x2 --hostlist="$hostlist"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger "splify"
}
